# orbit-status configuration file
# Place this at ~/.config/orbit-status/config
#
# Format: key = value
# Colors are: r g b a  (each 0.0 - 1.0)
# Integers and strings as expected

# === Bar ===
# bar_height = 38
# bar_anchor = top          # "top" or "bottom"
# bar_layer = top           # "top" or "overlay"
# bar_padding = 8
# bar_bg_color              # optional; if unset uses dark gradient
# accent_color = 0.0 0.90 1.0 1.0
# font_family = Sans

# === Status Notifier Tray ===
# show_tray = 1               # 1 to enable the system tray (DBus StatusNotifierItem)
# tray_icon_size = 24         # size of tray icons in pixels

# === Power Buttons ===
# show_power = 1
# icon_size = 24
# glow_width = 8
# glow_alpha_percent = 25
# icon_alpha_percent = 90
# icon_hover_alpha_percent = 100
# poweroff_color = 1.0 0.2 0.3 1.0
# reboot_color = 1.0 0.6 0.0 1.0
# suspend_color = 0.6 0.2 1.0 1.0

# === Workspaces ===
# show_hyperion = 1
# show_hyperion_logo = 1
# hyperion_color = 0.92 0.72 0.0 1.0
# workspace_font_size = 12
# workspace_switch_cmd = swaymsg workspace number %d
#   Command run when a workspace pill is clicked. %d is replaced with the
#   workspace number (1-based). Default: "swaymsg workspace number %d"

# === Active Window ===
# show_active_window = 1

# === Clock ===
# show_clock = 1
# date_format = %a %b %d  %H:%M
# clock_font_size = 11

# === Pill Styling ===
# pill_font_size = 9
# pill_pad_h = 4
# pill_pad_w = 8
# pill_gap = 6
# pill_order = 1,2,3        # optional; comma-separated 1-based plugin indices

# === Lua Plugins (up to 12) ===
# lua_plugins_dir = ~/.config/orbit-status/plugins
# lua_plugin_1_path = ~/.config/orbit-status/plugins/workspaces.lua
# lua_plugin_1_interval = 1
# lua_plugin_1_prefix = WS
# lua_plugin_1_color = 0.6 1.0 0.6 1.0
# show_lua_plugin_1 = 1
# click_lua_plugin_1 =       # shell command run on click
# lua_plugin_1_watch =       # optional file path to watch for changes
#
# Shell plugins (run a command instead of a Lua file):
# lua_plugin_2_cmd = cat /sys/class/power_supply/BAT0/capacity
# lua_plugin_2_interval = 30
