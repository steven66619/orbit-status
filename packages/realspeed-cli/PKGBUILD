# Maintainer: steven66619 <steven4x4@gmail.com>
pkgname=realspeed-cli
pkgver=1.0.0
pkgrel=1
pkgdesc="SamKnows-based internet speed test CLI"
arch=('x86_64')
url="https://github.com/steven66619/realspeed-cli"
license=('MIT')
depends=()
makedepends=('go')
# Source from release tags; the bump-versions workflow keeps pkgver in
# sync with the latest tag on the realspeed-cli repo.
source=("$pkgname-$pkgver.tar.gz::https://github.com/steven66619/realspeed-cli/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  make
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make PREFIX=/usr DESTDIR="$pkgdir" install
}