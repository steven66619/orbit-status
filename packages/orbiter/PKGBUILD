# Maintainer: steven66619 <steven4x4@gmail.com>
pkgname=orbiter
pkgver=1.0.4
pkgrel=1
pkgdesc="Wayland application launcher with search and app icons"
arch=('x86_64')
url="https://github.com/steven66619/orbiter"
license=('MIT')
depends=('wayland' 'cairo' 'pango' 'librsvg' 'libxkbcommon')
makedepends=('cmake' 'wayland-protocols' 'pkg-config')
# Source from release tags; the bump-versions workflow keeps pkgver in
# sync with the latest tag on the orbiter repo.
source=("$pkgname-$pkgver.tar.gz::https://github.com/steven66619/orbiter/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  make release
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 build/orbiter "$pkgdir/usr/bin/orbiter"
}