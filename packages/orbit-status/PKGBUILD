# Maintainer: steven66619 <steven4x4@gmail.com>
# Major releases get a codename (e.g. 1.8 "Nebula"); minor/bugfix releases are
# version-only (e.g. 1.9). The bump-versions workflow keeps pkgver/_ver/_codename
# in sync with the latest v<ver>[-<codename>] tag.
# pkgver carries the codename when present (1.8_nebula) so pacman shows it;
# _ver is the numeric version used for the source tarball URL.
pkgname=orbit-status
pkgver=2.0_discovery
_ver=2.0
_codename=discovery
pkgrel=1
pkgdesc="Lightweight Wayland status bar with Lua plugin support"
arch=('x86_64' 'aarch64')
url="https://github.com/steven66619/orbit-status"
license=('MIT')
depends=('wayland' 'cairo' 'pango' 'glib2' 'lua54' 'librsvg' 'dbus' 'libpulse')
makedepends=('wayland-protocols' 'lua')
# Source tarball: v<ver>-<codename> for codename releases, v<ver> otherwise.
if [ -n "$_codename" ]; then
  _tag="v$_ver-$_codename"
  _srcdir="$pkgname-$_ver-$_codename"
else
  _tag="v$_ver"
  _srcdir="$pkgname-$_ver"
fi
source=("$pkgname-$pkgver.tar.gz::https://github.com/steven66619/orbit-status/archive/$_tag.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$_srcdir"
  make PREFIX=/usr
}

package() {
  cd "$srcdir/$_srcdir"
  make PREFIX=/usr DESTDIR="$pkgdir" install
}