# Maintainer: steven66619 <steven4x4@gmail.com>
# Major releases get a codename (e.g. 1.0.0 "Blitz"); minor/bugfix releases
# are version-only. The bump-versions workflow keeps pkgver/_ver/_codename in
# sync with the latest v<ver>[-<codename>] tag.
# pkgver carries the codename when present (1.0.0_blitz) so pacman shows it;
# _ver is the numeric version used for the source tarball URL.
pkgname=realspeed-cli
pkgver=1.0.0_blitz
_ver=1.0.0
_codename=blitz
pkgrel=1
pkgdesc="SamKnows-based internet speed test CLI"
arch=('x86_64')
url="https://github.com/steven66619/realspeed-cli"
license=('MIT')
depends=()
makedepends=('go')
# Source tarball: v<ver>-<codename> for codename releases, v<ver> otherwise.
if [ -n "$_codename" ]; then
  _tag="v$_ver-$_codename"
  _srcdir="$pkgname-$_ver-$_codename"
else
  _tag="v$_ver"
  _srcdir="$pkgname-$_ver"
fi
source=("$pkgname-$pkgver.tar.gz::https://github.com/steven66619/realspeed-cli/archive/$_tag.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$_srcdir"
  make
}

package() {
  cd "$srcdir/$_srcdir"
  make PREFIX=/usr DESTDIR="$pkgdir" install
}