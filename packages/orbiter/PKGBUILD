# Maintainer: steven66619 <steven4x4@gmail.com>
# Major releases get a codename (e.g. 1.1.0 "Columbia"); minor/bugfix releases
# are version-only. The bump-versions workflow keeps pkgver/_ver/_codename in
# sync with the latest v<ver>[-<codename>] tag.
# pkgver carries the codename when present (1.1.0_columbia) so pacman shows it;
# _ver is the numeric version used for the source tarball URL.
pkgname=orbiter
pkgver=1.1.0_columbia
_ver=1.1.0
_codename=columbia
pkgrel=1
pkgdesc="Wayland application launcher with search and app icons"
arch=('x86_64')
url="https://github.com/steven66619/orbiter"
license=('MIT')
depends=('wayland' 'cairo' 'pango' 'librsvg' 'libxkbcommon')
makedepends=('cmake' 'wayland-protocols' 'pkg-config')
# Source tarball: v<ver>-<codename> for codename releases, v<ver> otherwise.
if [ -n "$_codename" ]; then
  _tag="v$_ver-$_codename"
  _srcdir="$pkgname-$_ver-$_codename"
else
  _tag="v$_ver"
  _srcdir="$pkgname-$_ver"
fi
source=("$pkgname-$pkgver.tar.gz::https://github.com/steven66619/orbiter/archive/$_tag.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$_srcdir"
  make release
}

package() {
  cd "$srcdir/$_srcdir"
  install -Dm755 build/orbiter "$pkgdir/usr/bin/orbiter"
}